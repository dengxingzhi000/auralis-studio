# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# 前端 / Electron (ADR-019)
# 注意：这些不能用前导 "/" 锚定到仓库根 —— 前端位于 apps/desktop/ 下，
# 锚定后 node_modules 与 dist 会被误提交。electron/dist 也命中 dist/。
node_modules/
dist/
*.tsbuildinfo

# 打包产物：NSIS 安装包与 win-unpacked 目录（每个 >100 MiB），
# 由 `npm run package:win` 随时重建，绝不能入库。
/apps/desktop/release*/
/apps/desktop/build/package-resources/

# 本地工具链与缓存（本项目全部落在 D 盘，不入库）
.cargo/registry/
.cargo/git/

# Superpowers 可视化伴侣的临时产物
/.superpowers/

# 本地开发运行目录（.devrun/）：Vite / Tauri dev 的日志、pid、截图，
# 以及 .devrun/webview2-data/ 下的整套 WebView2 用户数据（Cookies、
# Cache、Code Cache、GPUCache…）。这些是运行期垃圾，绝不能入库。
/.devrun/

# IDE
/.idea/
*.iml
/.vscode/

# 操作系统
Thumbs.db
desktop.ini
.DS_Store

# 运行期产物
*.log
# 本地预览 / 截图辅助（.devrun 不入库）
/.devrun/
