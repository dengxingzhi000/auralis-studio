{
  "name": "@auralis/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Auralis Studio 桌面应用（Electron + React 19 + Rust 引擎）",
  "license": "MIT OR Apache-2.0",
  "author": "Auralis Studio contributors",
  "homepage": "https://github.com/dengxingzhi000/auralis-studio",
  "main": "electron/dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:typecheck": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && node scripts/dev-electron.mjs",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "check:capture": "node ../../scripts/check-capture.mjs",
    "soak": "node ../../scripts/soak-engine.mjs",
    "licenses:generate": "node ../../scripts/generate-licenses.mjs",
    "licenses:check": "node ../../scripts/generate-licenses.mjs --check",
    "icon:build": "node scripts/make-icon.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "//": "所有前端依赖都由 Vite 打进 dist。Electron 运行时只加载 dist 与 electron/dist，因此生产依赖为空；把 React/Radix 放在 devDependencies 可避免 electron-builder 把 node_modules 复制进安装包。",
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.auralis.studio",
    "productName": "Auralis Studio",
    "copyright": "Copyright © 2026 Auralis Studio contributors",
    "asar": true,
    "npmRebuild": false,
    "electronVersion": "45.0.0",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/package-resources/engine",
        "to": "engine"
      },
      {
        "from": "build/package-resources/licenses",
        "to": "licenses"
      },
      {
        "from": "build/package-resources/docs",
        "to": "docs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auralis Studio",
      "uninstallDisplayName": "Auralis Studio ${version}",
      "artifactName": "Auralis-Studio-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
