{
  "name": "@auralis/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Auralis Studio 桌面应用（Electron + React 19 + Rust 引擎）",
  "main": "electron/dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:typecheck": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && node scripts/dev-electron.mjs",
    "electron:start": "npm run build && npm run electron:build && electron ."
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
